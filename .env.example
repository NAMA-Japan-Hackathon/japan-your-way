# Optional. Clean clones use the shared Cloudflare API without any keys.
# Use local to run exclusively with your own provider credentials; shared forces Cloudflare.
TRAVEL_API_MODE=shared
# Credentials below are needed only for TRAVEL_API_MODE=local.
# Keep actual credentials out of Git and out of chat.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional Google Flights/Hotels search via SerpApi; not a direct Agoda/MMT connection.
SERPAPI_API_KEY=
LITEAPI_KEY=
# Set to the public HTTPS origin in production; local requests use their own origin.
APP_ORIGIN=
# In production set a long random secret, shared by all server instances.
TRAVEL_SESSION_SECRET=
TRAVEL_HOURLY_LIMIT=160
